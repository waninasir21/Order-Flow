generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REP
  ADMIN
}

enum OrderStatus {
  PLACED
  APPROVED
  REJECTED
  FULFILLED
}

model Outlet {
  id        String   @id @default(cuid())
  name      String
  address   String
  ownerName String
  phone     String
  orders    Order[]
  employees Employee[] @relation("EmployeeOutlets")
  createdAt DateTime @default(now())
}

model Employee {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  // Unused in week 1; present now so week 2 auth needs no migration.
  passwordHash    String
  role            Role     @default(REP)
  assignedOutlets Outlet[] @relation("EmployeeOutlets")
  orders          Order[]
  createdAt       DateTime @default(now())
}

model Product {
  id            String      @id @default(cuid())
  name          String
  sku           String      @unique
  price         Decimal     @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
}

model Order {
  id         String      @id @default(cuid())
  outlet     Outlet      @relation(fields: [outletId], references: [id])
  outletId   String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  employeeId String
  status     OrderStatus @default(PLACED)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([outletId])
  @@index([employeeId])
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2)

  @@index([orderId])
}
