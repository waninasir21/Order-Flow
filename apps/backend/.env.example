# Copy to .env for local development. Never commit the real file (it is in .gitignore).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
PORT=4000

# Optional
# ANALYTICS_TIME_ZONE=Asia/Kolkata   # business time zone for "orders per day"
# CORS_ORIGINS=https://your-web-app.vercel.app   # production only; comma-separated; default allows no browser origins
# ENABLE_INTROSPECTION=true          # production only; introspection is off there by default
# SEED_PASSWORD=choose-one           # password for the seeded demo accounts (default password123, dev only)
# REDIS_URL=...                      # NOT read by the code today (PubSub is in-memory); see DECISIONS.md
