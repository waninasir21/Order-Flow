# Where the GraphQL backend lives. Used only on the server (the browser never talks to it).
BACKEND_GRAPHQL_URL="http://localhost:4000/graphql"

# Cookies are marked Secure in production builds. If you run `next start` over plain http on a
# LAN address (not localhost), set this to "false" or the browser will drop the session cookies.
# COOKIE_SECURE="false"
