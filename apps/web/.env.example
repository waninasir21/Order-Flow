# Copy to .env.local for local development.
# Server-side only (never exposed to the browser): the dashboard calls the backend from the Next.js server.
BACKEND_GRAPHQL_URL="http://localhost:4000/graphql"

# Cookies are Secure (https only) in production builds by default. Set to "false" only to run a
# production build over plain http on localhost.
# COOKIE_SECURE=false
